# Copy this file to .env and fill in your own values.
# .env is ignored by Git. Never put a real key in this file.

# Required. Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only if Anthropic answers "This API key is not scoped to a workspace":
# console.anthropic.com -> Settings -> Workspaces -> copy the workspace ID (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Optional. Model used for planning (default: claude-haiku-4-5-20251001, fast).
# Try claude-sonnet-5 for higher quality but slower answers.
PLANNER_MODEL=

# Optional. If set, the web page asks for this code before generating a plan.
ACCESS_CODE=

# Optional. Stripe payment: set both to sell a pass that unlocks plan generation.
# Test mode keys start with sk_test_. Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Dashboard -> Product catalogue -> add a product with a one-off price -> copy its id (price_...).
STRIPE_PRICE_ID=
# Optional. How many days a pass lasts (default 30).
STRIPE_PASS_DAYS=
# Optional. Public address of the site, where Stripe sends people back after paying.
# Leave empty locally; on Vercel set it to https://student-meal-planner-two.vercel.app
PUBLIC_URL=
